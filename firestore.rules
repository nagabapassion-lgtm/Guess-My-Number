rules_version = '2';

// Guess My Number — Firestore rules (v2.2 with user profiles).
//
// Schema (v2.2):
//   rooms/{roomId}                       - one multiplayer game room
//   rooms/{roomId}/guesses/{guessId}     - one guess per player attempt
//   dailyChallenge/{dateStr}             - container, no fields
//   dailyChallenge/{dateStr}/entries/{uid}  - one leaderboard entry per day
//   users/{uid}                          - one profile doc per user (NEW in v2.2)
//     fields: username, displayName, photoUrl, isAnonymous, updatedAt
//
// v2.2 changes from v2.1:
//   - Added users/{uid} collection. Each user owns their own doc
//     (uid must match their auth uid). They can read+write their own
//     doc only. This is where the editable username lives.
//
// Trust model: the secret is stored in Firestore by design. Rules
// enforce identity at create time (hostId must equal the caller's
// uid) and trust the player's device for in-game writes. User profile
// docs are owned by their uid - only the owner can read or write.

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Multiplayer rooms
    // ----------------------------------------------------------------
    match /rooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerId == null
        && request.resource.data.phase == 'waiting'
        && request.resource.data.round == 1;

      allow update: if request.auth != null;

      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      match /guesses/{guessId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
      }

      // Subcollection of players (Race mode, NEW in v5).
      //
      // rooms/{roomId}/players/{playerId}:
      //   playerId:        string — the player's auth uid (must match doc ID)
      //   playerName:      string (1..24 chars)
      //   currentMinBound: int
      //   currentMaxBound: int
      //   attemptsLeft:    int
      //   totalLives:      int
      //   lastGuess:       int?
      //   lastFeedback:    string?
      //   status:          string ("joining" | "guessing" | "won" | "lost" | "out")
      //   guessCount:      int
      //   finishPosition:  int
      //   joinedAt:        timestamp
      //   finishedAt:      timestamp?
      //
      // Rules:
      //   - read: any signed-in user can read all players (everyone
      //     sees the live standings during a race).
      //   - create: a player can create only their own doc (playerId
      //     must match their auth uid). This is how a player joins.
      //   - update: a player can update only their own doc. The host
      //     can also update any player doc (to flip status from
      //     'joining' to 'guessing' when the race starts).
      //   - delete: a player can delete their own doc (leaving). The
      //     host can also delete any player doc (when closing room).
      match /players/{playerId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && playerId == request.auth.uid
          && request.resource.data.playerId == request.auth.uid
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() > 0
          && request.resource.data.playerName.size() <= 24;

        allow update: if request.auth != null
          && (playerId == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);

        allow delete: if request.auth != null
          && (playerId == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);
      }
    }

    // ----------------------------------------------------------------
    // Daily Challenge leaderboard (solo mode)
    // ----------------------------------------------------------------
    match /dailyChallenge/{dateStr} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /dailyChallenge/{dateStr}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.guessCount is int
        && request.resource.data.guessCount >= 1
        && request.resource.data.guessCount <= 20
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 0;

      allow update: if false;
      allow delete: if false;
    }

    // ----------------------------------------------------------------
    // User profiles (NEW in v2.2)
    //
    // users/{uid}:
    //   username:      string (1..24 chars) — editable display name
    //   displayName:   string — Google display name (or empty)
    //   photoUrl:      string — Google photo URL (or empty)
    //   isAnonymous:   bool
    //   updatedAt:     timestamp
    //
    // Only the owner can read or write their profile. The uid in the
    // path must match the caller's auth uid. We validate the username
    // length on write (1..24 chars) so a malicious client can't
    // store garbage. Other fields are free-form because they come
    // from the user's Firebase Auth profile.
    // ----------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null
        && uid == request.auth.uid;

      allow create: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24;

      allow update: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24;

      allow delete: if request.auth != null
        && uid == request.auth.uid;

      // --------------------------------------------------------------
      // Game history subcollection (NEW in v2.3)
      //
      // users/{uid}/games/{gameId}:
      //   mode:          string
      //   role:          string
      //   opponentName:  string
      //   secretNumber:  int
      //   guessCount:    int
      //   result:        string ("won" | "lost")
      //   durationSec:   int
      //   playedAt:      timestamp
      //
      // Only the owner can read or write their game history. The
      // gameId is deterministic (room_id + round for multiplayer,
      // date for daily, timestamp for practice) so duplicate writes
      // are idempotent. We validate the result field to prevent
      // garbage data.
      // --------------------------------------------------------------
      match /games/{gameId} {
        allow read: if request.auth != null
          && uid == request.auth.uid;

        allow create: if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.result is string
          && (request.resource.data.result == 'won'
              || request.resource.data.result == 'lost')
          && request.resource.data.mode is string
          && request.resource.data.guessCount is int
          && request.resource.data.guessCount >= 0;

        allow update: if request.auth != null
          && uid == request.auth.uid;

        allow delete: if request.auth != null
          && uid == request.auth.uid;
      }
    }
  }
}
