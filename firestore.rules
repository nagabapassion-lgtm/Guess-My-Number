rules_version = '2';

// Guess My Number — Firestore rules (v2.2 with user profiles).
//
// Schema (v2.2):
//   rooms/{roomId}                       - one multiplayer game room
//   rooms/{roomId}/guesses/{guessId}     - one guess per player attempt
//   dailyChallenge/{dateStr}             - container, no fields
//   dailyChallenge/{dateStr}/entries/{uid}  - one leaderboard entry per day
//   users/{uid}                          - one profile doc per user (NEW in v2.2)
//     fields: username, displayName, photoUrl, isAnonymous, updatedAt
//
// v2.2 changes from v2.1:
//   - Added users/{uid} collection. Each user owns their own doc
//     (uid must match their auth uid). They can read+write their own
//     doc only. This is where the editable username lives.
//
// Trust model: the secret is stored in Firestore by design. Rules
// enforce identity at create time (hostId must equal the caller's
// uid) and trust the player's device for in-game writes. User profile
// docs are owned by their uid - only the owner can read or write.

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Multiplayer rooms
    // ----------------------------------------------------------------
    match /rooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerId == null
        && request.resource.data.phase == 'waiting'
        && request.resource.data.round == 1;

      allow update: if request.auth != null;

      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      match /guesses/{guessId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
      }
    }

    // ----------------------------------------------------------------
    // Daily Challenge leaderboard (solo mode)
    // ----------------------------------------------------------------
    match /dailyChallenge/{dateStr} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /dailyChallenge/{dateStr}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.guessCount is int
        && request.resource.data.guessCount >= 1
        && request.resource.data.guessCount <= 20
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 0;

      allow update: if false;
      allow delete: if false;
    }

    // ----------------------------------------------------------------
    // User profiles (NEW in v2.2)
    //
    // users/{uid}:
    //   username:      string (1..24 chars) — editable display name
    //   displayName:   string — Google display name (or empty)
    //   photoUrl:      string — Google photo URL (or empty)
    //   isAnonymous:   bool
    //   updatedAt:     timestamp
    //
    // Only the owner can read or write their profile. The uid in the
    // path must match the caller's auth uid. We validate the username
    // length on write (1..24 chars) so a malicious client can't
    // store garbage. Other fields are free-form because they come
    // from the user's Firebase Auth profile.
    // ----------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null
        && uid == request.auth.uid;

      allow create: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24;

      allow update: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24;

      allow delete: if request.auth != null
        && uid == request.auth.uid;
    }
  }
}
